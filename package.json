{
  "name": "claude-ttl-counter",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.7.0",
  "publisher": "purpleprintai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PurplePrintAI/save-ur-usage-limit-ttl-counter-for-claude-code"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "ttl",
    "prompt-cache",
    "cache",
    "usage-limit"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "claudeTtl.toggleMode",
        "title": "%command.toggleMode.title%"
      },
      {
        "command": "claudeTtl.installAdvisorSkill",
        "title": "%command.installAdvisorSkill.title%"
      },
      {
        "command": "claudeTtl.connectSubscriptionUsage",
        "title": "%command.connectSubscriptionUsage.title%"
      },
      {
        "command": "claudeTtl.disconnectSubscriptionUsage",
        "title": "%command.disconnectSubscriptionUsage.title%"
      },
      {
        "command": "claudeTtl.refreshSubscriptionUsage",
        "title": "%command.refreshSubscriptionUsage.title%"
      }
    ],
    "configuration": {
      "title": "Claude TTL Counter",
      "properties": {
        "claudeTtl.subscriptionUsage.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.subscriptionUsage.enabled%"
        },
        "claudeTtl.subscriptionUsage.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 20,
          "maximum": 600,
          "description": "%config.subscriptionUsage.pollIntervalSeconds%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "build": "npm run compile",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/vscode": "^1.99.0",
    "typescript": "^5.8.3"
  }
}
